Jacobi[A0_, B0_, P0_, max_] :=
 Module[{A = N[A0], B = N[B0], i, j, k = 0, n = Length[P0], P = P0,
   Pold = P0},
  Print[Subscript["p", 0], "=", P];

  While[k < max,
   For[i = 1, i <= n, i++,
    P[[i]] = 1/A[[i, i]] (
       B[[i]] + A[[i, i]]*P[[i]] -
        Sum[A[[i, j]]*P[[j]], {j, 1, n}]
       )
    ];

   Print[Subscript["p", k + 1], "=", P];
   k = k + 1;
   ];

  Return[P];
  ]

